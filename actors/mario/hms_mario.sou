// Removed 'RCP_FarMarioHierarchy_XLU' (Far Mario Transparent) Hierarchy

/********************************************************************************/
/*	Mario hierarchy map data.													*/
/********************************************************************************/
Hierarchy RCP_MarioHierarchy[] = { // Removed 'CtrlMarioAlpha', 'CtrlMarioRenderMode' and the "XLU" hierarchy calls
 	hmsShadow(100, 180, 99)
	hmsBegin()
		hmsScale(0.25f)
		hmsBegin()
			hmsSelect(0, CtrlMarioLOD)
			hmsBegin()
				hmsCall(RCP_NearMarioHierarchy)				
				hmsGroup()
				hmsBegin()
					hmsLOD(-2048,600)
					hmsBegin()
						hmsCall(RCP_NearMarioHierarchy)					
					hmsEnd()

					hmsLOD(600,1600)
					hmsBegin()
						hmsCall(RCP_MidMarioHierarchy)				
					hmsEnd()

					hmsLOD(1600,32767)
					hmsBegin()
						hmsCall(RCP_FarMarioHierarchy)					
					hmsEnd()
				hmsEnd()
			hmsEnd()
		hmsEnd()
	hmsEnd()
	hmsExit()
};

/********************************************************************************/
/*	Mario hierarchy map data for title.											*/
/********************************************************************************/

Hierarchy RCP_TitleMario[] = {
	hmsScale(0.25f)
	hmsBegin()
		hmsCall(RCP_TitleMarioHierarchy)
	hmsEnd()
	hmsExit()
};
