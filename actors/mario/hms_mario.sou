							hmsSelect(0, CtrlMarioHand)
							hmsBegin()
								hmsJoint(RM_SURF, RCP_mario_mid3 , 60, 0, 0)		/* m_rhand1		*/
								hmsBegin()
									hmsSucker(0,0,0, 0,CtrlMarioTaking)
